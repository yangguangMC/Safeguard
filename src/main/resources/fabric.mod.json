{
  "schemaVersion": 1,
  "id": "safeguard",
  "version": "${version}",
  "name": "Safe Guard",
  "description": "A client-side mod that helps you avoid possible dangers in survival mode.",
  "authors": [
    "yangguangMC"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/safeguard/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "top.yangguangmc.safeguard.SafeGuard"
    ],
    "modmenu": [
      "top.yangguangmc.safeguard.SafeGuardModMenuApiImpl"
    ]
  },
  "mixins": [
    "safeguard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config": ">=${cloth_config_version}"
  }
}
